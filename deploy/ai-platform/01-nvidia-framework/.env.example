# ==============================================================================
# YGGDRASIL DATA PLATFORM — 01-NVIDIA-FRAMEWORK (TITAN STACK)
# ==============================================================================
# File cấu hình chuẩn hóa khớp 100% với biến môi trường gốc của:
# 1. NVIDIA auto-ontology (Backend, Ingestion, Prisma Frontend, MCP Server)
# 2. NVIDIA NeMo-Retriever (Service Config YAML, LanceDB VectorDB, NIM Endpoints)
# 3. Arize Phoenix (OpenTelemetry Tracing, Prompt CMS & Playground)
# 4. NVIDIA NemoClaw (Autonomous Agent Worker & OpenShell Sandbox)
# 5. NVIDIA Nemotron Voice Agent (Pipecat WebRTC/WebSocket + Talker/Thinker Cascaded Voice)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU TRI THỨC (POSTGRES + PGVECTOR)
# ------------------------------------------------------------------------------
POSTGRES_USER=yggdrasil
POSTGRES_PASSWORD=yggdrasil_secret_password
POSTGRES_DATABASE=auto_ontology
POSTGRES_PORT=5432

# Chuỗi kết nối tới Data Warehouse / DB nguồn mà auto-ontology sẽ quét schema
CONNECTION_STRINGS=postgresql://yggdrasil:yggdrasil_secret_password@postgres:5432/auto_ontology

# ------------------------------------------------------------------------------
# 2. TÀI KHOẢN QUẢN TRỊ AUTO-ONTOLOGY WEB UI (BẮT BUỘC >= 8 KÝ TỰ)
# ------------------------------------------------------------------------------
AUTO_ONTOLOGY_ADMIN_EMAIL=admin@yggdrasil.local
AUTO_ONTOLOGY_ADMIN_PASSWORD=yggdrasil_admin_123
# AUTH_SECRET đồng thời được dùng làm OPENCLAW_GATEWAY_TOKEN để đăng nhập NemoClaw (:7681)
AUTH_SECRET=yggdrasil_super_secret_auth_key_2026
APP_URL=http://localhost:3000
AUTO_ONTOLOGY_MCP_PUBLIC_URL=http://localhost:3003

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MODEL TRIPLETS CHO AUTO-ONTOLOGY (CHUẨN OPENAI-COMPATIBLE)
# ------------------------------------------------------------------------------
# Hỗ trợ cắm DeepSeek / Gemini / OpenAI / Groq hoặc NVIDIA Cloud API
DEFAULT_MODELS_ENDPOINT=https://api.deepseek.com/v1
DEFAULT_MODELS_API_KEY=sk-your-llm-api-key-here
DEFAULT_MODELS_MODEL=deepseek-chat

# Model suy luận sinh SQL (Để trống sẽ tự động kế thừa DEFAULT_MODELS_* ở trên)
REASONING_ENDPOINT=https://api.deepseek.com/v1
REASONING_API_KEY=sk-your-llm-api-key-here
REASONING_MODEL=deepseek-chat

# Model bóc tách thực thể nhanh (Non-reasoning)
NON_REASONING_ENDPOINT=https://api.deepseek.com/v1
NON_REASONING_API_KEY=sk-your-llm-api-key-here
NON_REASONING_MODEL=deepseek-chat

# Model Embedding (Bắt buộc khai báo tường minh cho auto-ontology & NeMo-Retriever)
EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_API_KEY=nvapi-your-nvidia-key-here
EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Model Rerank kết quả SQL & RAG
RERANK_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
RERANK_API_KEY=nvapi-your-nvidia-key-here
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH NEMO-RETRIEVER (MULTIMODAL OCR, BẢNG BIỂU & VECTORDB)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
NGC_API_KEY=

# Các Endpoint bóc tách Layout & Bảng biểu (nemotron-page-elements-v3, nemotron-table-structure-v1) & OCR (nemotron-ocr-v2):
# - Mặc định gọi qua Cloud API của NVIDIA.
# - Nếu bật `--profile local-vision`, đổi thành:
#   NIM_PAGE_ELEMENTS_URL=http://nim-page-elements:8000/v1/infer
#   NIM_TABLE_STRUCTURE_URL=http://nim-table-structure:8000/v1/infer
#   NIM_OCR_URL=http://nim-ocr:8000/v1/infer
NIM_PAGE_ELEMENTS_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-page-elements-v3
NIM_TABLE_STRUCTURE_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-table-structure-v1
NIM_OCR_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
NIM_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Đọc biểu đồ (Captioning): Mặc định để null để tắt model 30B nặng nề
NIM_CAPTION_URL=null
NIM_CAPTION_MODEL_YAML=null

# ------------------------------------------------------------------------------
# 5. CỔNG DỊCH VỤ EXPOSE RA MÁY HOST
# ------------------------------------------------------------------------------
ONTOLOGY_WEB_PORT=3000
ONTOLOGY_API_PORT=3001
ONTOLOGY_INGEST_PORT=3002
ONTOLOGY_MCP_PORT=3003
RETRIEVER_HTTP_PORT=7670
RETRIEVER_VDB_PORT=7671
PHOENIX_PORT=6006
NEMOCLAW_PORT=7681
NEMOCLAW_IMAGE=ghcr.io/nvidia/nemoclaw/sandbox-base:latest

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH NEMOTRON VOICE AGENT (PIPECAT WEBRTC / REALTIME VOICE GATEWAY)
# ------------------------------------------------------------------------------
VOICE_AGENT_PORT=7860
# Kiến trúc mặc định: frontend-backend-agent (Tách Talker LLM <200ms và Thinker LLM chạy RAG/SQL)
# Hoặc chọn: multilingual-assistant, generic-assistant, omni-assistant
VOICE_EXAMPLE_SELECTION=frontend-backend-agent
# Chế độ dịch vụ: cloud (dùng NVIDIA Cloud API) | server (dùng local NIM khi bật --profile local-voice)
VOICE_SERVICE_RECIPE=cloud
VOICE_PIPELINE_TLS=false
USE_SILERO_VAD_TURN_DETECTION=false
SILERO_VAD_STOP_SECS=0.3
