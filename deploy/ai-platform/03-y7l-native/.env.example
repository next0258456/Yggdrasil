# ==============================================================================
# YGGDRASIL DATA PLATFORM — 03-Y7L-NATIVE (V0.1 N8N-CENTRIC BOOTSTRAP)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THIN TRACK-B SIDECAR (y7l-tools)
# ------------------------------------------------------------------------------
Y7L_TOOLS_PORT=8300
OBSIDIAN_VAULT_PATH=./vault
DATA_DIR=./data
FMCG_SALES_PARQUET_PATH=

# ------------------------------------------------------------------------------
# 2. XÁC THỰC ZERO-TRUST (10H JWT + REDIS SESSION)
# ------------------------------------------------------------------------------
JWT_SECRET=y7l_dev_jwt_secret_change_me_2026
JWT_TTL_SECONDS=36000
REDIS_URL=redis://host.docker.internal:6379/0

# Để trống = thực thi trực tiếp bằng In-Process DuckDB + RLS tại y7l-tools.
# Điền URL (VD: http://host.docker.internal:8088) để ủy quyền sang Superset SQL Lab.
SUPERSET_URL=

# ------------------------------------------------------------------------------
# 3. CỔNG LLM & VOICE / EMBEDDING (TRỎ QUA LITELLM PROXY :4000)
# ------------------------------------------------------------------------------
LLM_API_BASE=http://host.docker.internal:4000/v1
LLM_API_KEY=sk-yggdrasil-master-admin-2026
LLM_MODEL=yggdrasil-default-llm
EMBED_MODEL=text-embedding-3-small
STT_MODEL=whisper-1
TTS_VOICE=vi-VN-HoaiMyNeural

# ------------------------------------------------------------------------------
# 4. GOOGLE SHEETS NGÀY 1 (HR MASTER IAM & FINOPS TOKEN LEDGER)
# ------------------------------------------------------------------------------
Y7L_IAM_SHEET_ID=
Y7L_FINOPS_SHEET_ID=
DEPT_MONTHLY_BUDGET_USD=5.0

# ------------------------------------------------------------------------------
# 5. KẾT NỐI N8N / POSTGRES CHO STANDALONE PROFILE & IMPORT SCRIPT
# ------------------------------------------------------------------------------
N8N_URL=http://localhost:5678
N8N_API_KEY=
POSTGRES_USER=y7l
POSTGRES_PASSWORD=y7l_secret_password
POSTGRES_DB=y7l_rag

# ==============================================================================
# NÂNG CẤP NGÀY 10 -> 02-LANGFUSE (CLICKHOUSE OLAP + PROMPT CMS, 0 SỬA N8N)
# ==============================================================================
# Khi muốn bật Langfuse Tracing + ClickHouse OLAP mà KHÔNG sửa bất kỳ workflow n8n nào:
# 1. Khởi động stack 02-langfuse (`../02-langfuse/docker-compose.yaml`)
# 2. Bật trong LiteLLM env:
#    LANGFUSE_HOST=http://langfuse-web:3000
#    LANGFUSE_PUBLIC_KEY=pk-lf-...
#    LANGFUSE_SECRET_KEY=sk-lf-...
# Mọi call LLM qua LLM_API_BASE=http://host.docker.internal:4000/v1 sẽ tự động
# đổ trace & cost về ClickHouse song song với Google Sheet Token Ledger.
