      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst chatUserId = String(input.chat_user_id || input.user_id || 'anonymous');\nconst prompt = String(input.prompt || input.text || '').trim();\nconst isVoice = Boolean(input.is_voice || input.audio_url || input.audio_base64);\nconst exportFormat = String(input.export_format || 'csv').toLowerCase();\nreturn [{ json: { chat_user_id: chatUserId, prompt, is_voice: isVoice, export_format: exportFormat, audio_url: input.audio_url || '' } }];"
      },
