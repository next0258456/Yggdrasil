        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'yggdrasil-default-llm', temperature: 0, messages: [{ role: 'system', content: 'Phân loại câu hỏi thành ĐÚNG 1 chuỗi JSON: {\"intent\": \"KPI|SQL|SOP\", \"metric_name\": \"net_revenue_by_region|monthly_revenue|top_customers|order_count_summary|null\"}. KPI dùng cho doanh thu theo khu vực/tháng/top khách hàng/tổng đơn chuẩn; SQL dùng cho truy vấn số liệu tự do; SOP dùng cho quy trình/chính sách.' }, { role: 'user', content: $json.prompt }] }) }}",
        "options": {}
      },
      "id": "wf01-llm-intent-router",
      "name": "LLM_Intent_Router",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1680, 220],
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const authCtx = $('Redis_Get_10h_JWT').first().json;\nconst llmResp = $input.first().json;\nconst choices = Array.isArray(llmResp.choices) ? llmResp.choices : [];\nconst raw = (choices[0] && choices[0].message && choices[0].message.content) ? choices[0].message.content : '';\nlet parsed = { intent: 'SOP', metric_name: null };\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  const p = String(authCtx.prompt || '').toLowerCase();\n  if (p.includes('quy trình') || p.includes('chính sách') || p.includes('phụ cấp') || p.includes('hoàn đơn')) {\n    parsed = { intent: 'SOP', metric_name: null };\n  } else if (p.includes('khu vực')) {\n    parsed = { intent: 'KPI', metric_name: 'net_revenue_by_region' };\n  } else {\n    parsed = { intent: 'SQL', metric_name: null };\n  }\n}\nconst usage = llmResp.usage || {};\nreturn [{\n  json: {\n    chat_user_id: authCtx.chat_user_id,\n    prompt: authCtx.prompt,\n    is_voice: authCtx.is_voice,\n    export_format: authCtx.export_format,\n    jwt_token: authCtx.jwt_token,\n    intent: String(parsed.intent || 'SOP').toUpperCase(),\n    metric_name: parsed.metric_name || 'net_revenue_by_region',\n    model: llmResp.model || 'yggdrasil-default-llm',\n    prompt_tokens: Number(usage.prompt_tokens || 0),\n    completion_tokens: Number(usage.completion_tokens || 0),\n    total_tokens: Number(usage.total_tokens || 0)\n  }\n}];"
      },
