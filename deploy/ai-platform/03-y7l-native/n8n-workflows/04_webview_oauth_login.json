        "jsCode": "const body = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    username: String(body.username || '').trim(),\n    password: String(body.password || ''),\n    chat_user_id: String(body.chat_user_id || 'anonymous').trim()\n  }\n}];"
