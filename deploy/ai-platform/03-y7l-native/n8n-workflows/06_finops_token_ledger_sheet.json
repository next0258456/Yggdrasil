            {"id": "estimated_cost_usd", "displayName": "estimated_cost_usd", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "number"},
            {"id": "status", "displayName": "status", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string"}
          ]
