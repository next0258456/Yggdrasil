{
  "name": "Y7L 06 - FinOps Token Ledger to Google Sheet & Key Kill-Switch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "y7l-token-log",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf06-webhook-log",
      "name": "Webhook_Log_Token_Usage",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [120, 160],
      "webhookId": "y7l-token-log",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst now = new Date();\nconst model = String(body.model || 'yggdrasil-default-llm').trim();\nconst promptTokens = Math.max(0, Number(body.prompt_tokens || 0));\nconst completionTokens = Math.max(0, Number(body.completion_tokens || 0));\nconst totalTokens = Math.max(0, Number(body.total_tokens || (promptTokens + completionTokens)));\n\nconst PRICING_PER_1M = {\n  'yggdrasil-default-llm': [0.27, 1.10],\n  'deepseek-chat': [0.27, 1.10],\n  'gpt-4o-mini': [0.15, 0.60],\n  'gpt-4o': [2.50, 10.00],\n  'gemini-2.5-flash': [0.15, 0.60],\n  'nvidia/llama-3.1-nemotron-70b-instruct': [0.88, 0.88],\n  'text-embedding-3-small': [0.02, 0.00],\n  'whisper-1': [0.00, 0.00]\n};\nconst rates = PRICING_PER_1M[model.toLowerCase()] || [0.30, 1.20];\nconst estimatedCostUsd = Number(((promptTokens * rates[0] + completionTokens * rates[1]) / 1000000).toFixed(6));\nconst department = String(body.department || 'general');\nconst month = now.toISOString().slice(0, 7);\n\nreturn [{\n  json: {\n    timestamp: now.toISOString(),\n    month,\n    department,\n    user_id: String(body.user_id || 'anonymous'),\n    workflow: String(body.workflow || 'unknown'),\n    model,\n    prompt_tokens: promptTokens,\n    completion_tokens: completionTokens,\n    total_tokens: totalTokens,\n    estimated_cost_usd: estimatedCostUsd,\n    cost_micro_usd: Math.round(estimatedCostUsd * 1000000),\n    virtual_key: String(body.virtual_key || ''),\n    monthly_budget_usd: Number(body.monthly_budget_usd || 5.0),\n    status: String(body.status || 'ok')\n  }\n}];"
      },
