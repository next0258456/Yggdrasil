# ==============================================================================
# YGGDRASIL DATA PLATFORM — 02-LANGFUSE (PRODUCTION LLMOPS STACK)
# ==============================================================================
# Stack cấu hình chuẩn sản xuất cho Langfuse v3 + ClickHouse OLAP
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CỔNG DỊCH VỤ TRÊN HOST
# ------------------------------------------------------------------------------
LANGFUSE_PORT=3100
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
MINIO_CONSOLE_PORT=9091
MINIO_API_PORT=9090

# ------------------------------------------------------------------------------
# 2. XÁC THỰC VÀ BẢO MẬT LANGFUSE (BẮT BUỘC ĐỔI KHI LÊN PRODUCTION)
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=yggdrasil_langfuse_nextauth_secret_2026
SALT=yggdrasil_langfuse_salt_key_2026
# ENCRYPTION_KEY phải đủ 64 ký tự hex (256-bit)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU METADATA (POSTGRESQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse_secret_password
POSTGRES_DB=langfuse

# ------------------------------------------------------------------------------
# 4. CƠ SỞ DỮ LIỆU PHÂN TÍCH OLAP (CLICKHOUSE)
# ------------------------------------------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse_secret_password
CLICKHOUSE_DB=default

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (MINIO / S3 CHO HEAVY TRACES & ATTACHMENTS)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_2026
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse

# ------------------------------------------------------------------------------
# 6. LANGFUSE AI GATEWAY (NATIVE RUST LLM PROXY & ROUTER)
# ------------------------------------------------------------------------------
LANGFUSE_AI_GATEWAY_PORT=3031
LANGFUSE_AI_GATEWAY_PUBLIC_URL=http://localhost:3031
LANGFUSE_AI_GATEWAY_SERVICE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_AI_GATEWAY_DEPLOYED=true
LANGFUSE_AI_GATEWAY_ENABLED=true
LANGFUSE_AI_GATEWAY_JWT_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEIH1Tl+mxxCuwTx7nDK7ExUz4wEuiTAEMA1xOxMySN5BboAoGCCqGSM49\nAwEHoUQDQgAEQMkB7xfnLj+/7NNojzQE2nCAY2SfaM7udPg3O4coBMEWTWHLL5ec\nx8l4sh4FVcvBzTpE+PLjxPR9/nh+Wr3puQ==\n-----END EC PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 7. LITELLM PROXY — CẦU DAO CẮT TIỀN TỰ ĐỘNG (HARD SPEND CAP) & THU HỒI API KEY
# ------------------------------------------------------------------------------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-yggdrasil-master-admin-2026

# Khóa API của Project trên Langfuse (:3100) để LiteLLM bắn Trace & Cost vào ClickHouse
LANGFUSE_PUBLIC_KEY=pk-lf-local-test
LANGFUSE_SECRET_KEY=sk-lf-local-test

# Cấu hình Upstream LLM (Mặc định trỏ qua Langfuse AI Gateway :3031 hoặc gọi thẳng NIM/OpenAI)
UPSTREAM_LLM_API_BASE=http://ai-gateway:3031/v1
UPSTREAM_LLM_API_KEY=lf-gw-default-upstream-key
DEFAULT_LLM_MODEL=deepseek-chat
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
OPENAI_API_KEY=sk-your-openai-key-here
